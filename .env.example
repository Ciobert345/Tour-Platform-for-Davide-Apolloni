# ==============================================================================
# COPIA questo file in .env.local e riempi i valori
#   cp .env.example .env.local
#
# Recupera queste chiavi da Supabase Dashboard → Settings → API
#   https://supabase.com/dashboard/project/_/settings/api
# ==============================================================================

# ====== Supabase ======
# URL progetto (es. https://abc123xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
# Chiave anon pubblica (serve al browser — NON mettere la service_role key!)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# (Opzionale) Service Role Key — usata SOLO lato server (route handlers, server actions)
# NON committarla!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ====== Email provider (Resend) — per Edge Functions ======
# Setta queste ANCHE nelle secrets di Supabase Edge Functions
RESEND_API_KEY=re_xxxxxx
ADMIN_EMAIL=guidaturistica@davideapolloni.it
RESEND_FROM_NAME="Davide Apolloni Guida Turistica"
RESEND_FROM=noreply@davideapolloni.it

# ====== Lingua ======
NEXT_PUBLIC_DEFAULT_LANG=it

# ====== Modalità Manutenzione (override) ======
# Imposta a "true" o "1" per bypassare la modalità manutenzione
# sul tuo ambiente locale. Utile per lavorare sul sito mentre
# il toggle del DB è su "attiva".
# Alternative rapide senza variabile:
#   ?bypass_maint=1  → attiva bypass per 8 ore (cookie sessione)
#   ?maint_back=1    → torna a vedere la pagina in costruzione
NEXT_PUBLIC_MAINTENANCE_OVERRIDE=
